# Copy this file to .env and fill in the values.

# Backend
DATABASE_PATH=storage/app.db
STORAGE_ROOT=storage

# Shared secret between the backend and the agent runtime. Use any long random string.
AGENT_RUNTIME_TOKEN=change-me

# Where each service finds the other
AGENT_RUNTIME_URL=http://127.0.0.1:8090
BACKEND_URL=http://127.0.0.1:8000

# Agent runtime
# 32 bytes as 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_CREDENTIAL_KEY=
# Must be a model your Codex account can use
AGENT_MODEL=gpt-5.5
AGENT_MAX_TURNS=12

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
